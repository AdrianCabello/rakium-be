generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         UserRole
  clientId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client?   @relation(fields: [clientId], references: [id])
  projects     Project[] @relation("CreatedBy")

  @@map("User")
}

model Client {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  projects            Project[]
  lifeAreas           LifeArea[]
  tasks               PersonalTask[]
  notes               PersonalNote[]
  financeAccounts     FinanceAccount[]
  financeCategories   FinanceCategory[]
  financeTransactions FinanceTransaction[]

  @@map("Client")
}

model LifeArea {
  id         String         @id @default(uuid())
  clientId   String         @map("client_id")
  name       String
  color      String?
  icon       String?
  order      Int            @default(0)
  archivedAt DateTime?      @map("archived_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks      PersonalTask[]
  notes      PersonalNote[]

  @@unique([clientId, name], name: "unique_life_area_per_client")
  @@map("life_areas")
}

model PersonalTask {
  id               String             @id @default(uuid())
  clientId         String             @map("client_id")
  areaId           String?            @map("area_id")
  title            String
  description      String?
  status           PersonalTaskStatus @default(TODO)
  priority         PersonalPriority   @default(NORMAL)
  dueDate          DateTime?          @map("due_date")
  scheduledDate    DateTime?          @map("scheduled_date")
  completedAt      DateTime?          @map("completed_at")
  estimatedMinutes Int?               @map("estimated_minutes")
  tags             Json?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  area             LifeArea?          @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([clientId, status, dueDate])
  @@index([clientId, scheduledDate])
  @@map("personal_tasks")
}

model PersonalNote {
  id         String           @id @default(uuid())
  clientId   String           @map("client_id")
  areaId     String?          @map("area_id")
  title      String?
  content    String
  type       PersonalNoteType @default(BRAIN_DUMP)
  pinned     Boolean          @default(false)
  archivedAt DateTime?        @map("archived_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  area       LifeArea?        @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([clientId, type, createdAt])
  @@map("personal_notes")
}

model FinanceAccount {
  id             String               @id @default(uuid())
  clientId       String               @map("client_id")
  name           String
  type           FinanceAccountType   @default(CASH)
  currency       String               @default("ARS")
  initialBalance Decimal              @default(0) @map("initial_balance") @db.Decimal(12, 2)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions   FinanceTransaction[]

  @@unique([clientId, name], name: "unique_finance_account_per_client")
  @@map("finance_accounts")
}

model FinanceCategory {
  id            String                 @id @default(uuid())
  clientId      String                 @map("client_id")
  name          String
  type          FinanceTransactionType
  color         String?
  icon          String?
  hint          String?
  expenseMode   String?                @default("daily") @map("expense_mode")
  monthlyBudget Decimal?               @map("monthly_budget") @db.Decimal(12, 2)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  client        Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions  FinanceTransaction[]

  @@unique([clientId, name, type], name: "unique_finance_category_per_client")
  @@map("finance_categories")
}

model FinanceTransaction {
  id          String                 @id @default(uuid())
  clientId    String                 @map("client_id")
  accountId   String?                @map("account_id")
  categoryId  String?                @map("category_id")
  type        FinanceTransactionType
  amount      Decimal                @db.Decimal(12, 2)
  currency    String                 @default("ARS")
  date        DateTime               @default(now())
  isPaid      Boolean                @default(true) @map("is_paid")
  description String?
  merchant    String?
  notes       String?
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  client      Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account     FinanceAccount?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category    FinanceCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([clientId, date])
  @@index([clientId, type, date])
  @@map("finance_transactions")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  value     String    @unique
  orderNum  Int       @default(0) @map("order_num")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  projects  Project[]

  @@map("Category")
}

model Project {
  id              String           @id @default(uuid())
  name            String
  type            ProjectType?
  status          ProjectStatus    @default(DRAFT) @map("status")
  category        ProjectCategory?
  description     String?
  longDescription String?          @map("long_description")
  imageBefore     String?          @map("image_before")
  imageAfter      String?          @map("image_after")
  latitude        Float?           @map("latitude")
  longitude       Float?           @map("longitude")
  country         String?
  state           String?
  city            String?
  area            String?
  duration        String?
  date            String?
  url             String?
  clientId        String           @map("client_id")
  categoryId      String?          @map("category_id")
  challenge       String?
  solution        String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  beforeImageId   String?          @unique @map("before_image_id")
  afterImageId    String?          @unique @map("after_image_id")
  coverImageId    String?          @unique @map("cover_image_id")
  createdBy       String?
  endDate         DateTime?        @map("end_date")
  startDate       DateTime?        @map("start_date")
  address         Json?            @map("address")
  budget          String?          @map("budget")
  contactEmail    String?          @map("contact_email")
  contactName     String?          @map("contact_name")
  contactPhone    String?          @map("contact_phone")
  invoiceStatus   String?          @map("invoice_status")
  notes           String?          @map("notes")
  order           Int              @default(0) @map("order")
  githubUrl       String?          @map("github_url")
  demoUrl         String?          @map("demo_url")
  technologies    Json?            @map("technologies")
  gallery         Gallery[]
  videos          Video[]
  afterImage      Gallery?         @relation("AfterImage", fields: [afterImageId], references: [id])
  beforeImage     Gallery?         @relation("BeforeImage", fields: [beforeImageId], references: [id])
  coverImage      Gallery?         @relation("CoverImage", fields: [coverImageId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  categoryRef     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator         User?            @relation("CreatedBy", fields: [createdBy], references: [id])

  @@unique([clientId, order], name: "unique_order_per_client")
  @@map("projects")
}

model Gallery {
  id            String   @id @default(uuid())
  url           String
  title         String?
  description   String?
  order         Int      @default(0)
  projectId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  afterImageOf  Project? @relation("AfterImage")
  beforeImageOf Project? @relation("BeforeImage")
  coverImageOf  Project? @relation("CoverImage")

  @@map("Gallery")
}

model Video {
  id          String   @id @default(uuid())
  title       String
  description String?
  youtubeUrl  String   @map("youtube_url")
  order       Int      @default(0)
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("Video")
}

model Lead {
  id                   String         @id @default(uuid())
  name                 String
  city                 String
  region               String?
  category             String?
  address              String?
  latitude             Float?
  longitude            Float?
  phone                String?
  email                String?
  website              String?
  instagram            String?
  facebook             String?
  googleMapsUrl        String?        @map("google_maps_url")
  source               LeadSource     @default(MANUAL)
  sourceId             String?        @map("source_id")
  sourceUrl            String?        @map("source_url")
  digitalPresenceScore Int            @default(0) @map("digital_presence_score")
  needsWebsite         Boolean        @default(false) @map("needs_website")
  instagramQuality     LeadQuality?   @map("instagram_quality")
  priority             Int            @default(2)
  status               LeadStatus     @default(NEW)
  assignedTo           String?        @map("assigned_to")
  assignedSellerId     String?        @map("assigned_seller_id")
  tags                 Json?
  checklist            Json?
  estimatedValue       Int?           @map("estimated_value")
  suggestedMessage     String?        @map("suggested_message")
  convertedClientId    String?        @map("converted_client_id")
  notes                String?
  lastContactedAt      DateTime?      @map("last_contacted_at")
  nextFollowUpAt       DateTime?      @map("next_follow_up_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  activities           LeadActivity[]
  seller               Seller?        @relation(fields: [assignedSellerId], references: [id], onDelete: SetNull)
  sellerActivities     SellerActivity[]
  instagramConversations InstagramConversation[]

  @@unique([source, sourceId], name: "unique_lead_source")
  @@index([city])
  @@index([category])
  @@index([status])
  @@index([assignedSellerId])
  @@map("leads")
}

model InstagramConversation {
  id              String                      @id @default(uuid())
  senderId        String                      @unique @map("sender_id")
  username        String?
  leadId          String?                     @map("lead_id")
  status          InstagramConversationStatus @default(UNMATCHED)
  lastMessageText String?                     @map("last_message_text")
  lastMessageAt   DateTime?                   @map("last_message_at")
  rawProfile      Json?                       @map("raw_profile")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  lead            Lead?                       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages        InstagramMessage[]

  @@index([leadId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("instagram_conversations")
}

model InstagramMessage {
  id             String                    @id @default(uuid())
  conversationId String                    @map("conversation_id")
  messageId      String                    @unique @map("message_id")
  direction      InstagramMessageDirection
  text           String?
  attachments    Json?
  raw            Json?
  receivedAt     DateTime                  @default(now()) @map("received_at")
  conversation   InstagramConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, receivedAt])
  @@index([direction])
  @@map("instagram_messages")
}

model LeadActivity {
  id          String           @id @default(uuid())
  leadId      String           @map("lead_id")
  type        LeadActivityType
  note        String?
  channel     String?
  createdAt   DateTime         @default(now()) @map("created_at")
  scheduledAt DateTime?        @map("scheduled_at")
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@map("lead_activities")
}

model Seller {
  id                String           @id @default(uuid())
  name              String
  email             String?          @unique
  phone             String?
  instagram         String?
  linkedin          String?
  city              String?
  role              String?
  status            SellerStatus     @default(TRAINING)
  profileChecklist  Json?            @map("profile_checklist")
  salesPlaybook     Json?            @map("sales_playbook")
  notes             String?
  dailyTarget       Int?             @default(30) @map("daily_target")
  weeklyVisitTarget Int?             @default(10) @map("weekly_visit_target")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  leads             Lead[]
  activities        SellerActivity[]

  @@index([status])
  @@index([city])
  @@map("sellers")
}

model SellerActivity {
  id              String             @id @default(uuid())
  sellerId        String             @map("seller_id")
  leadId          String?            @map("lead_id")
  type            SellerActivityType
  channel         String?
  note            String?
  outcome         String?
  address         String?
  latitude        Float?
  longitude       Float?
  occurredAt      DateTime           @default(now()) @map("occurred_at")
  nextFollowUpAt  DateTime?          @map("next_follow_up_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  seller          Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  lead            Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([sellerId, occurredAt])
  @@index([leadId])
  @@index([type])
  @@map("seller_activities")
}

enum UserRole {
  ADMIN
  CLIENT_ADMIN
  CLIENT
}

enum ProjectType {
  LANDING
  ECOMMERCE
  INMOBILIARIA
  CUSTOM
  PORTFOLIO
  BLOG
  CORPORATIVO
  ONE_PAGE
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  PENDING
}

enum ProjectCategory {
  ESTACIONES
  TIENDAS
  COMERCIALES
  SITIO_WEB
}

enum PersonalPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum PersonalTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum PersonalNoteType {
  BRAIN_DUMP
  IDEA
  IMPORTANT
  REFLECTION
}

enum FinanceAccountType {
  CASH
  BANK
  DIGITAL_WALLET
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

enum LeadSource {
  MANUAL
  GOOGLE_PLACES
  GOOGLE_SEARCH
  INSTAGRAM
  CSV
  WEBSITE
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  REPLIED
  MEETING
  WON
  LOST
  ARCHIVED
}

enum LeadQuality {
  UNKNOWN
  POOR
  OK
  GOOD
}

enum LeadActivityType {
  NOTE
  INSTAGRAM_SENT
  WHATSAPP_SENT
  EMAIL_SENT
  CALLED
  REPLIED
  FOLLOW_UP
  STATUS_CHANGE
}

enum SellerStatus {
  TRAINING
  ACTIVE
  PAUSED
  INACTIVE
}

enum SellerActivityType {
  INSTAGRAM_SENT
  LINKEDIN_SENT
  WHATSAPP_SENT
  EMAIL_SENT
  CALLED
  VISITED
  MEETING
  REPLIED
  FOLLOW_UP
  NOTE
}

enum InstagramConversationStatus {
  UNMATCHED
  MATCHED
  ARCHIVED
}

enum InstagramMessageDirection {
  INBOUND
  OUTBOUND
}
