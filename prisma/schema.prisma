generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         UserRole
  clientId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client?   @relation(fields: [clientId], references: [id])
  projects     Project[] @relation("CreatedBy")

  @@map("User")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  projects  Project[]
  lifeAreas LifeArea[]
  tasks     PersonalTask[]
  notes     PersonalNote[]
  financeAccounts FinanceAccount[]
  financeCategories FinanceCategory[]
  financeTransactions FinanceTransaction[]

  @@map("Client")
}

model LifeArea {
  id        String    @id @default(uuid())
  clientId  String    @map("client_id")
  name      String
  color     String?
  icon      String?
  order     Int       @default(0)
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks     PersonalTask[]
  notes     PersonalNote[]

  @@map("life_areas")
  @@unique([clientId, name], name: "unique_life_area_per_client")
}

model PersonalTask {
  id          String             @id @default(uuid())
  clientId    String             @map("client_id")
  areaId      String?            @map("area_id")
  title       String
  description String?
  status      PersonalTaskStatus @default(TODO)
  priority    PersonalPriority   @default(NORMAL)
  dueDate     DateTime?          @map("due_date")
  scheduledDate DateTime?        @map("scheduled_date")
  completedAt DateTime?          @map("completed_at")
  estimatedMinutes Int?          @map("estimated_minutes")
  tags        Json?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  area        LifeArea?          @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@map("personal_tasks")
  @@index([clientId, status, dueDate])
  @@index([clientId, scheduledDate])
}

model PersonalNote {
  id        String           @id @default(uuid())
  clientId  String           @map("client_id")
  areaId    String?          @map("area_id")
  title     String?
  content   String
  type      PersonalNoteType @default(BRAIN_DUMP)
  pinned    Boolean          @default(false)
  archivedAt DateTime?       @map("archived_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  area      LifeArea?        @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@map("personal_notes")
  @@index([clientId, type, createdAt])
}

model FinanceAccount {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  name      String
  type      FinanceAccountType @default(CASH)
  currency  String   @default("ARS")
  initialBalance Decimal @default(0) @map("initial_balance") @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@map("finance_accounts")
  @@unique([clientId, name], name: "unique_finance_account_per_client")
}

model FinanceCategory {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  name      String
  type      FinanceTransactionType
  color     String?
  icon      String?
  monthlyBudget Decimal? @map("monthly_budget") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@map("finance_categories")
  @@unique([clientId, name, type], name: "unique_finance_category_per_client")
}

model FinanceTransaction {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  accountId   String?  @map("account_id")
  categoryId  String?  @map("category_id")
  type        FinanceTransactionType
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("ARS")
  date        DateTime @default(now())
  description String?
  merchant    String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account     FinanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category    FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("finance_transactions")
  @@index([clientId, date])
  @@index([clientId, type, date])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  value     String    @unique
  orderNum  Int       @default(0) @map("order_num")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  projects  Project[]

  @@map("Category")
}

model Project {
  id              String           @id @default(uuid())
  name            String
  type            ProjectType?
  status          ProjectStatus    @default(DRAFT) @map("status")
  category        ProjectCategory?
  description     String?
  longDescription String?          @map("long_description")
  imageBefore     String?          @map("image_before")
  imageAfter      String?          @map("image_after")
  latitude        Float?           @map("latitude")
  longitude       Float?           @map("longitude")
  country         String?
  state           String?
  city            String?
  area            String?
  duration        String?
  date            String?
  url             String?
  clientId        String           @map("client_id")
  categoryId      String?          @map("category_id")
  challenge       String?
  solution        String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  beforeImageId   String?          @unique @map("before_image_id")
  afterImageId    String?          @unique @map("after_image_id")
  coverImageId    String?          @unique @map("cover_image_id")
  createdBy       String?
  endDate         DateTime?        @map("end_date")
  startDate       DateTime?        @map("start_date")
  address         Json?            @map("address")
  budget          String?          @map("budget")
  contactEmail    String?          @map("contact_email")
  contactName     String?          @map("contact_name")
  contactPhone    String?          @map("contact_phone")
  invoiceStatus   String?          @map("invoice_status")
  notes           String?          @map("notes")
  order           Int              @default(0) @map("order")
  githubUrl       String?          @map("github_url")
  demoUrl         String?          @map("demo_url")
  technologies    Json?            @map("technologies")
  gallery         Gallery[]
  videos          Video[]
  afterImage      Gallery?         @relation("AfterImage", fields: [afterImageId], references: [id])
  beforeImage     Gallery?         @relation("BeforeImage", fields: [beforeImageId], references: [id])
  coverImage      Gallery?         @relation("CoverImage", fields: [coverImageId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  categoryRef     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator         User?            @relation("CreatedBy", fields: [createdBy], references: [id])

  @@map("projects")
  @@unique([clientId, order], name: "unique_order_per_client")
}

model Gallery {
  id            String   @id @default(uuid())
  url           String
  title         String?
  description   String?
  order         Int      @default(0)
  projectId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  afterImageOf  Project? @relation("AfterImage")
  beforeImageOf Project? @relation("BeforeImage")
  coverImageOf  Project? @relation("CoverImage")

  @@map("Gallery")
}

model Video {
  id          String   @id @default(uuid())
  title       String
  description String?
  youtubeUrl  String   @map("youtube_url")
  order       Int      @default(0)
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("Video")
}

enum UserRole {
  ADMIN
  CLIENT_ADMIN
  CLIENT
}

enum ProjectType {
  LANDING
  ECOMMERCE
  INMOBILIARIA
  CUSTOM
  PORTFOLIO
  BLOG
  CORPORATIVO
  ONE_PAGE
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  PENDING
}

enum ProjectCategory {
  ESTACIONES
  TIENDAS
  COMERCIALES
  SITIO_WEB
}

enum PersonalPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum PersonalTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum PersonalNoteType {
  BRAIN_DUMP
  IDEA
  IMPORTANT
  REFLECTION
}

enum FinanceAccountType {
  CASH
  BANK
  DIGITAL_WALLET
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
}
